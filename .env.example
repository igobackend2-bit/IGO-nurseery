# ── Frontend (Vite / React) ──────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Vercel Serverless Functions (api/*.js) ───────────────────────────────────
# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_PASTE_YOUR_KEY_HERE

# Sender address (must be a verified domain in your Resend account)
# During testing you can use: IGO Nursery <onboarding@resend.dev>
FROM_EMAIL=IGO Nursery <noreply@igonursery.com>

# Supabase Admin (Server-side only — NEVER expose in frontend)
# Settings → API → service_role key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin notification recipient
ADMIN_EMAIL=igonursery@gmail.com

# ── Legacy (used by api/send-email.js for order/lead emails) ─────────────────
VITE_ORDER_EMAIL_API_URL=https://igonursery.com/api/send-order-email
