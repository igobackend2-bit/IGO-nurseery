# ============================================================
#  IGO Nursery — Environment Variables Template
#  Copy this file to .env.local and fill in your real values.
#  NEVER commit .env.local or any file with real secrets to Git.
# ============================================================

# --- Supabase (Frontend) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# --- Supabase (Server / API) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# --- Backend API ---
VITE_ORDER_EMAIL_API_URL=https://your-backend.example.com/api/send-order-email
API_PORT=4000

# --- Admin Credentials ---
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your-secure-admin-password

# --- SMTP Email ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
